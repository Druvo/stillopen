# Copy to .env and edit. .env is gitignored; never commit it.

# --- Django ---
DJANGO_DEBUG=1
# Leave empty locally: a key is generated into .secret_key on first run.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Needed when served behind nginx/another host name, e.g. http://jobs.home.lan
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Defaults seeded into the admin "Site configuration" on first migrate ---
# Everything below can be changed later in the admin panel.
# Admin-only: folder of a career-ops checkout to import from. Leave empty if you do not use it.
CAREEROPS_PATH=
NODE_COMMAND=node

# --- Paperless-ngx (optional) ---
# If set, these take precedence over the admin fields. Create a token in
# Paperless: My Profile -> API token.
PAPERLESS_URL=http://127.0.0.1:8010
PAPERLESS_TOKEN=

# --- docker-compose (paperless stack) ---
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_SECRET_KEY=

# --- Social sign-in: Google, GitHub, Facebook (optional) ---
# Easiest: leave these empty and add the Google app in the admin ("Social applications").
# If both are set here they are used instead. Create the OAuth client yourself in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub and Facebook work the same way (both free): GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET, FACEBOOK_CLIENT_ID / FACEBOOK_CLIENT_SECRET.
# Then tick the matching box in the admin under Site configuration > Social sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Running as a shared service (see docs/HOSTING.md) ---
# Postgres password for docker compose --profile web
POSTGRES_PASSWORD=
# Your public host name(s); comma separated
# DJANGO_ALLOWED_HOSTS=jobs.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://jobs.example.com
# Set to 1 once TLS is terminated by a proxy in front of the app
DJANGO_HTTPS=0
# Outgoing email (sign-up confirmation links). Without EMAIL_HOST the links are printed to the server log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=StillOpen <noreply@example.com>
# Per-person limits
STILLOPEN_MAX_APPLICATIONS=500
STILLOPEN_MAX_KNOWLEDGE=40
STILLOPEN_EVALS_PER_HOUR=30
STILLOPEN_CHECKS_PER_HOUR=12
# Each scan hits every enabled JobSource's external API once; kept conservative to stay polite to those hosts.
STILLOPEN_SCANS_PER_HOUR=6

# Optional: free Jooble key (https://jooble.org/api/about) adds Bangladesh, Malaysia and Gulf job search. Can also be set in the admin.
# JOOBLE_API_KEY=
