# Settings for deploy/backup-offsite.sh. Copy to ~/.stillopen-offsite.env (or set OFFSITE_ENV_FILE) and keep it private:  chmod 600
# Plain VAR=value lines only. Real environment variables win over this file. There is no password in here, on purpose:
# rclone keeps its credentials in its own config (`rclone config`), and ssh uses a key file.

# rclone (preferred): any rclone remote, ideally an encrypted one ("crypt") so the provider cannot read your backups.
OFFSITE_METHOD=rclone
OFFSITE_REMOTE=myremote:stillopen-backups

# rsync or scp over ssh instead (the remote folder must already exist, and the host's key must be in known_hosts):
#OFFSITE_METHOD=rsync
#OFFSITE_REMOTE=backup@backup.example.com:/srv/backups/stillopen
#OFFSITE_SSH_KEY=/home/you/.ssh/stillopen_backup

# How many copies to keep at the remote (the newest ones).
OFFSITE_KEEP=7

# Where deploy/backup-postgres.sh writes (default ~/stillopen-backups).
#BACKUP_DIR=/home/you/stillopen-backups

# Also copy the secret key. Without it a restored copy cannot decrypt stored API keys (people re-enter them), so this is optional,
# but it is the one file that unlocks them: only turn it on for an encrypted remote you control.
#OFFSITE_INCLUDE_SECRET_KEY=1

# Also copy an archive of uploaded files (Docker setup).
#OFFSITE_INCLUDE_MEDIA=1
